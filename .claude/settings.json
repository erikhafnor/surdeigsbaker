      "Bash(esphome run *)",
      "Bash(esphome upload *)",
      "Bash(idf.py flash *)",
      "Bash(idf.py app-flash *)",
      "Bash(esptool *)",
      "Bash(esptool.py *)",
      "Bash(python -m esptool *)",
      "Bash(pio run -t upload *)",
      "Bash(pio run --target upload *)",
      "Bash(platformio run -t upload *)",
      "Bash(platformio run --target upload *)",
